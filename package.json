{
  "name": "telegram-news-agent",
  "version": "2.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build:nest": "tsc -p tsconfig.build.json",
    "test": "node --test",
    "test:drizzle": "tsx --test checks/drizzle-schema.ts",
    "test:drizzle:sources": "tsx --test checks/sources-repository.ts",
    "test:nest:build": "npm run build:nest && node checks/emitted-database-module.mjs && node checks/emitted-usage-application.mjs && node checks/emitted-settings-application.mjs && node checks/emitted-catalog-research-application.mjs && node checks/emitted-evidence-curation.mjs && node checks/emitted-operations-application.mjs && node checks/emitted-editorial-application.mjs && node checks/emitted-telegram-control-application.mjs && node checks/emitted-telegram-polling-worker.mjs && node checks/emitted-scheduler-application.mjs && node checks/emitted-runtime-bootstrap.mjs && node checks/emitted-news-scheduler-worker.mjs && node checks/emitted-telemetry-adapters.mjs && node checks/emitted-ai-provider-core.mjs && node checks/emitted-news-agent-composition.mjs && node checks/emitted-runtime-health-cli.mjs && node checks/emitted-runtime-signals.mjs",
    "test:persistence": "tsx --test checks/persistence/*.ts",
    "test:application": "tsx --test checks/application/*.ts",
    "test:architecture": "tsx --test checks/architecture/*.ts",
    "test:runtime": "tsx --test checks/runtime/*.ts",
    "test:ops": "./checks/ops/deploy-integration-guards.sh && ./checks/ops/deploy-gate.sh && ./checks/ops/production-runtime.sh",
    "test:e2e": "./ops/e2e.sh all",
    "test:e2e:up": "./ops/e2e.sh up",
    "test:e2e:run": "./ops/e2e.sh run",
    "test:e2e:down": "./ops/e2e.sh down",
    "test:integration:drizzle": "RUN_DATABASE_INTEGRATION=1 tsx --test checks/integration/*.ts",
    "test:integration": "RUN_DATABASE_INTEGRATION=1 node --test test/integration/*.test.js",
    "typecheck": "tsc --noEmit",
    "database:migrate": "node scripts/migrate.mjs",
    "database:new": "node scripts/new-migration.mjs",
    "database:status": "node --env-file-if-exists=.env scripts/migration-status.mjs",
    "database:drift": "tsx scripts/schema-drift.ts",
    "database:contract": "node scripts/postgres-contract.mjs",
    "database:check": "node --env-file=.env src/database-check.js",
    "audit:flush": "node --env-file=.env src/audit-outbox-cli.js",
    "drafts": "node --env-file=.env src/drafts-cli.js",
    "pipeline:run": "node --env-file=.env src/pipeline-cli.js",
    "research": "node --env-file=.env src/research-cli.js",
    "sources": "node --env-file=.env src/sources-cli.js",
    "usage:dashboard": "npm run build:nest && node --env-file-if-exists=.env dist/usage/usage-dashboard-cli.js",
    "telegram:check": "node --env-file=.env src/telegram-check.js",
    "telegram:control": "node --env-file=.env src/telegram-bot.js",
    "runtime:start": "npm run build:nest && node --env-file-if-exists=.env dist/composition/runtime-entry.js",
    "runtime:health": "node --env-file-if-exists=.env dist/composition/health-cli.js",
    "telegram:control:container": "node src/telegram-bot.js",
    "telegram:send": "node --env-file=.env src/send-message.js",
    "telegram:smoke": "node --env-file=.env src/telegram-smoke.js",
    "secrets:edit:production": "bash ops/sops-production-env.sh edit",
    "secrets:decrypt:production": "bash ops/sops-production-env.sh decrypt",
    "secrets:encrypt:production": "bash ops/sops-production-env.sh encrypt",
    "secrets:validate:production": "bash ops/sops-production-env.sh validate"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "cheerio": "^1.1.2",
    "drizzle-orm": "^0.45.2",
    "exa-js": "^2.18.1",
    "fast-xml-parser": "^5.10.1",
    "openai": "^7.4.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
