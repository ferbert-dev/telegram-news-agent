{
  "name": "telegram-news-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:nest": "tsc -p tsconfig.build.json",
    "test": "node --test",
    "test:drizzle": "tsx --test checks/drizzle-schema.ts",
    "test:drizzle:sources": "tsx --test checks/sources-repository.ts",
    "test:nest:build": "npm run build:nest && node checks/emitted-database-module.mjs",
    "test:persistence": "tsx --test checks/persistence/*.ts",
    "test:integration:drizzle": "RUN_DATABASE_INTEGRATION=1 tsx --test checks/integration/*.ts",
    "test:integration": "RUN_DATABASE_INTEGRATION=1 node --test test/integration/*.test.js",
    "typecheck": "tsc --noEmit",
    "database:migrate": "node scripts/migrate.mjs",
    "database:new": "node scripts/new-migration.mjs",
    "database:status": "node --env-file-if-exists=.env scripts/migration-status.mjs",
    "database:drift": "tsx scripts/schema-drift.ts",
    "database:contract": "node scripts/postgres-contract.mjs",
    "database:check": "node --env-file=.env src/database-check.js",
    "audit:flush": "node --env-file=.env src/audit-outbox-cli.js",
    "drafts": "node --env-file=.env src/drafts-cli.js",
    "pipeline:run": "node --env-file=.env src/pipeline-cli.js",
    "research": "node --env-file=.env src/research-cli.js",
    "sources": "node --env-file=.env src/sources-cli.js",
    "telegram:check": "node --env-file=.env src/telegram-check.js",
    "telegram:control": "node --env-file=.env src/telegram-bot.js",
    "telegram:control:container": "node src/telegram-bot.js",
    "telegram:send": "node --env-file=.env src/send-message.js",
    "telegram:smoke": "node --env-file=.env src/telegram-smoke.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "cheerio": "^1.1.2",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "openai": "^7.4.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
