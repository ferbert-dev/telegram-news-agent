TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_UPDATE_MODE=polling
# Which runtime the bot container starts. Optional: omit it and compose defaults
# to the legacy entrypoint. This is the cutover switch AND the rollback switch --
# it lives here rather than in compose.yaml because deploy.sh restores this file
# on rollback but not compose.yaml. Only two values are accepted:
#   src/telegram-bot.js                   (legacy, the default)
#   dist/composition/runtime-entry.js     (compiled NestJS runtime)
# BOT_ENTRYPOINT=src/telegram-bot.js
TELEGRAM_POLLING_MIGRATE_WEBHOOK=false
TELEGRAM_NEWS_JOB_MODE=off
TELEGRAM_NEWS_JOB_POLL_INTERVAL_MS=2000
TELEGRAM_NEWS_JOB_STALE_AFTER_SECONDS=1800
TELEGRAM_NEWS_JOB_MAX_EXECUTION_ATTEMPTS=3
TELEGRAM_NEWS_JOB_MAX_DELIVERY_ATTEMPTS=10
APPROVAL_POLICY=manual
AI_PROVIDER_ORDER=openai,gemini
EXA_ENABLED=false
EXA_API_KEY=
EXA_SEARCH_TYPE=auto
EXA_MODEL=
EXA_DAILY_SEARCH_CAP=20
EXA_MAX_RESULTS=8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-2026-03-05
OPENAI_REASONING_EFFORT=medium
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenRouter. Typed runtime only -- the legacy JS entrypoint does not know this
# provider. Leave the key blank and it stays out of the cascade entirely.
#
# The model is optional: left blank, the provider asks OpenRouter which models
# exist and picks the largest-context FREE one that supports structured
# outputs, so a retired model id cannot silently pin this to something stale.
# Set it to skip discovery and pin a model outright.
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=
OPEN_ROUTER_MIN_CONTEXT_TOKENS=200000
NEWS_EDITOR_KEY=mikhail-onest
NEWS_EDITOR_NAME=Михаил Онест
NEWS_SOURCE_URL=
NOTION_API_KEY=
NOTION_AGENT_RUNS_DATA_SOURCE_ID=8eef7282-532e-4cf9-b309-bf09f9e9afeb
NOTION_PIPELINE_AGENT_PAGE_ID=38bd7885-0eab-81f4-9879-e8b4b990e314
NOTION_PIPELINE_TICKET_PAGE_ID=
DATABASE_URL=postgresql://telegram_news_app:change-me@localhost:5432/telegram_news
DATABASE_POOL_MAX=4
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_SSH_TUNNEL_PORT=55432
